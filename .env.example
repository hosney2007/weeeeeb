SECRET_KEY=change-me

# Hostinger MySQL database (Hosting -> Databases -> MySQL Databases in hPanel).
# Format: mysql+pymysql://DB_USER:DB_PASSWORD@DB_HOST/DB_NAME
# DB_HOST is usually "localhost" when the app and DB are on the same Hostinger plan.
DATABASE_URL=mysql+pymysql://u123456_dbuser:dbpassword@localhost/u123456_dbname

MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-gmail-app-password

# Optional: only needed if you're using Supabase Storage for uploaded files.
# Leave both empty to store uploads locally under static/uploads instead.
SUPABASE_URL=
SUPABASE_KEY=

VODAFONE_CASH_NUMBER=01012345678
INSTAPAY_ID=mohamedhosney@instapay

# Where "new order" notification emails go. Leave empty to reuse MAIL_USERNAME.
ADMIN_EMAIL=
